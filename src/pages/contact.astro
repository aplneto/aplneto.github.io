---
import { getEntry, render } from 'astro:content';
import NotebookSheet from '../components/reader/NotebookSheet.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'contact');
if (!page) {
  throw new Error('Missing src/content/pages/contact.md');
}
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description ?? 'Contact information.'}>
  <NotebookSheet title={page.data.title} description={page.data.description}>
    <Content />
  </NotebookSheet>
</BaseLayout>
