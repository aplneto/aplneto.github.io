---
import { getCollection, render } from 'astro:content';
import NotebookSheet from '../../components/reader/NotebookSheet.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  estimateReadingTimeMinutes,
  formatIsoDate,
  isPublished,
  withBase,
} from '../../utils/content';

export async function getStaticPaths() {
  const entries = await getCollection('entries', (entry) => isPublished(entry));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const readingTimeMinutes = estimateReadingTimeMinutes(entry.body);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <nav class="entry-breadcrumb" aria-label="Breadcrumb">
    <a href={withBase('/')}>Desktop</a>
    <span aria-hidden="true">/</span>
    <a href={withBase('/notes/')}>Notes</a>
    <span aria-hidden="true">/</span>
    <span>{entry.data.title}</span>
  </nav>

  <NotebookSheet
    title={entry.data.title}
    description={entry.data.description}
    dateLabel={formatIsoDate(entry.data.publishedAt)}
    updatedLabel={entry.data.updatedAt ? formatIsoDate(entry.data.updatedAt) : undefined}
    entryNumber={entry.data.entryNumber}
    category={entry.data.category}
    kind={entry.data.kind}
    status={entry.data.status}
    tags={entry.data.tags}
    readingTimeMinutes={readingTimeMinutes}
    draft={entry.data.draft}
    repository={entry.data.repository}
    retractionReason={entry.data.retractionReason}
    retractedAtLabel={entry.data.retractedAt ? formatIsoDate(entry.data.retractedAt) : undefined}
    headings={headings}
    doodleKind={entry.data.category}
  >
    <Content />
  </NotebookSheet>
</BaseLayout>

<style>
  .entry-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.86rem;
    color: var(--os-panel-text);
  }

  .entry-breadcrumb a {
    color: #d7e8f8;
  }
</style>
