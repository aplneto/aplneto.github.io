---
interface Props {
  kind?: 'security' | 'ai' | 'engineering' | 'miscellaneous' | 'system';
  position?: 'top' | 'bottom';
}

const { kind = 'miscellaneous', position = 'top' } = Astro.props;
---

<div class:list={['notebook-doodle', `notebook-doodle--${position}`]} aria-hidden="true">
  {kind === 'security' && position === 'top' && (
    <svg viewBox="0 0 40 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="20" width="24" height="20" rx="3" />
      <path d="M13 20v-5a7 7 0 0 1 14 0v5" />
      <circle cx="20" cy="29" r="2.2" />
      <path d="M20 31.5v4" />
    </svg>
  )}
  {kind === 'ai' && position === 'top' && (
    <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <circle cx="8" cy="12" r="3" />
      <circle cx="8" cy="32" r="3" />
      <circle cx="22" cy="8" r="3" />
      <circle cx="22" cy="22" r="3" />
      <circle cx="22" cy="36" r="3" />
      <circle cx="36" cy="22" r="3" />
      <path d="M11 12l8-3M11 13l8 8M11 31l8-8M11 32l8 3M25 9l8 11M25 22h8M25 35l8-11" />
    </svg>
  )}
  {kind === 'engineering' && position === 'top' && (
    <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <ellipse cx="22" cy="22" rx="16" ry="7" transform="rotate(30 22 22)" />
      <ellipse cx="22" cy="22" rx="16" ry="7" transform="rotate(-30 22 22)" />
      <circle cx="22" cy="22" r="2.5" fill="currentColor" />
    </svg>
  )}
  {(kind === 'miscellaneous' || kind === 'system') && position === 'top' && (
    <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 6l4.2 10.6L37 18l-8.2 7.2L31 36l-9-5.4L13 36l2.2-10.8L7 18l10.8-1.4z" />
    </svg>
  )}
  {position === 'bottom' && (
    <svg viewBox="0 0 44 36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 26c8-14 18-14 28-4" />
      <path d="M28 16l6 6-8 1" />
    </svg>
  )}
</div>
