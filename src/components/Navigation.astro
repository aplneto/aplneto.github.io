---
import { SITE_CONFIG } from '../site.config';
import { withBase } from '../utils/content';
import ThemeSwitch from './ThemeSwitch.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
void currentPath;
---

<header class="site-nav-bar">
  <div class="site-nav-bar__inner">
    <a class="site-brand" href={withBase('/')}>
      <span class="site-brand__mark" aria-hidden="true">📓</span>
      <span>{SITE_CONFIG.siteName}</span>
    </a>

    <div class="site-nav-actions">
      <ThemeSwitch compact />
    </div>
  </div>
</header>

<style>
  .site-nav-bar {
    background: var(--os-panel);
    color: var(--os-panel-text);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-nav-bar__inner {
    max-width: 78rem;
    margin: 0 auto;
    padding: 0.55rem clamp(0.75rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1.25rem;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.96rem;
    color: var(--os-panel-text);
    text-decoration: none;
  }

  .site-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
</style>
